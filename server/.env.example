# Firebase Admin SDK — extraia esses 3 valores do JSON baixado em:
# Firebase Console > Configurações do projeto > Service accounts > Generate new private key
FIREBASE_PROJECT_ID="seu-projeto-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-projeto-id.iam.gserviceaccount.com"
# Cole a private_key do JSON exatamente como veio, entre aspas (as quebras de linha "\n" ficam escapadas mesmo)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
# Bucket do Cloud Storage — mesmo valor de VITE_FIREBASE_STORAGE_BUCKET no
# client/.env (Firebase Console > Storage, ou Configurações do projeto > General).
FIREBASE_STORAGE_BUCKET="seu-projeto-id.appspot.com"

# Origem do frontend (para CORS). Em dev local: http://localhost:5173
# Em produção: a URL do site no Cloudflare Pages, sem barra no final
# (ex. https://posologiaslides.pages.dev ou seu domínio customizado).
CLIENT_URL="http://localhost:5173"

PORT=3001

# Narração por IA (ElevenLabs) para slides de código com voz — ver
# server/routes/narrationRoutes.js. Opcional: sem isto, a rota de narração
# devolve 503 e o slide cai de volta pra voz nativa do navegador.
# ELEVENLABS_API_KEY="sk_..."

# Backup agendado (server/scripts/scheduledBackup.js, disparado via
# systemd timer — ver server/scripts/systemd/). Ambos opcionais.
# BACKUP_DIR="/home/usuario/posologia-backups"   # padrão: server/backups
# BACKUP_RETENTION=7                              # backups mais recentes mantidos por usuário
# BACKUP_OFFSITE_UPLOAD=true                      # também sobe o .zip pro Cloud Storage (sobrevive à perda do disco/máquina)

# Nome do processo pm2 usado pelo deploy automático (server/scripts/deploy.sh)
# pra reiniciar o backend depois de um `git pull`. Só precisa disto se o
# processo no servidor tiver sido iniciado com um nome diferente do padrão
# (ex.: "pm2 start index.js --name backend" em vez de
# "pm2 start ecosystem.config.cjs", que usa o nome "posologia-backend").
# PM2_PROCESS_NAME="posologia-backend"

# Alerta por e-mail (server/scripts/notify.js) — usado pelo deploy.sh quando
# um deploy falha e reverte sozinho, e por server/scripts/healthcheck.js
# (rodado via cron) quando o backend para de responder. Pra Gmail: precisa de
# verificação em 2 etapas ativada na conta, depois gerar uma "Senha de app"
# em myaccount.google.com/apppasswords — NÃO é a senha normal da conta.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="seuemail@gmail.com"
# SMTP_PASS="senha de app de 16 caracteres, sem espaços"
# ALERT_EMAIL_TO="seuemail@gmail.com"
